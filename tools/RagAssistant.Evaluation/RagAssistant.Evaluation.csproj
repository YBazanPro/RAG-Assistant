<Project Sdk="Microsoft.NET.Sdk">

  <!-- The evaluation harness (spec 018): a console tool run on demand against a running AppHost, never part of dotnet test. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UserSecretsId>ragassistant-evaluation</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- LanguageDetector: the answer-language check uses the same detector as the app (spec 018). -->
    <ProjectReference Include="..\..\src\RagAssistant.SharedKernel\RagAssistant.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
