@inject IDocumentsApi Api

<FluentCard Class="meta-card">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
        @if (_mode == Mode.Conflict)
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false" role="alert" Class="conflict-banner">
                <ChildContent>This document was changed by someone else.</ChildContent>
                <ActionsTemplate>
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="ReloadAsync">Reload</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="KeepEditing">Keep editing</FluentButton>
                </ActionsTemplate>
            </FluentMessageBar>
        }

        @if (_formError is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false" role="alert">@_formError</FluentMessageBar>
        }

        <div aria-live="polite">
            @if (_saved)
            {
                <FluentText Class="saved-note">Changes saved.</FluentText>
            }
        </div>

        @if (!IsEditing)
        {
            @if (CanEdit && DetectedOther is { } detected)
            {
                @* The owner's choice is kept (spec 018); detection only advises. *@
                <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false" Class="language-detected">
                    <ChildContent>Detected: @Formatting.LanguageName(detected)</ChildContent>
                    <ActionsTemplate>
                        <FluentButton Appearance="ButtonAppearance.Outline" Disabled="Saving" OnClick="UseDetectedAsync">Use @Formatting.LanguageName(detected)</FluentButton>
                    </ActionsTemplate>
                </FluentMessageBar>
            }

            <MetaRow Label="Title">@Document.Title</MetaRow>
            <MetaRow Label="Owner">@Document.OwnerName</MetaRow>
            <MetaRow Label="Language">
                @Formatting.LanguageName(Document.Language)@(Document.LanguageSource == "detect" ? " (detected)" : "")
                @if (Document.LanguageDetection == "uncertain")
                {
                    <div class="field-hint" role="note">Language could not be detected reliably.</div>
                }
            </MetaRow>
            <MetaRow Label="Tags">
                @if (Document.Tags.Length == 0)
                {
                    <span>—</span>
                }
                @foreach (var tag in Document.Tags)
                {
                    <FluentBadge Appearance="BadgeAppearance.Outline" Class="tag-chip">@tag</FluentBadge>
                }
            </MetaRow>
            <MetaRow Label="Effective date">@(Document.EffectiveDate is { } date ? Formatting.Date(date) : "—")</MetaRow>
            <MetaRow Label="Source">@(string.IsNullOrWhiteSpace(Document.Source) ? "—" : Document.Source)</MetaRow>
            <MetaRow Label="Visibility">@(Document.Visibility == "private" ? "Private: only the person who imported it can read it" : "Shared: everyone who signs in can read it")</MetaRow>
            @if (Document.LatestVersion is { } latest)
            {
                <MetaRow Label="File">
                    @latest.OriginalFileName · @Formatting.FormatLabel(latest.SourceFormat) · @Formatting.Size(latest.SizeBytes)
                    <OriginalFileLink DocumentId="Document.Id" VersionNumber="latest.Number" SourceFormat="@latest.SourceFormat" />
                    @if (Formatting.PagesWithoutTextWarning(latest.PagesWithoutText) is { } warning)
                    {
                        <div class="version-warning" role="note">@warning</div>
                    }
                </MetaRow>
            }
        }
        else
        {
            <FluentTextInput Id="md-title" Label="Title" Required="true" MaxLength="200" Immediate="true" ImmediateDelay="0" Disabled="Saving"
                             @bind-Value="_title" Message="@Error("title")" MessageCondition="@(_ => Error("title") is not null)" MessageState="MessageState.Error" />
            <FluentTextInput Id="md-owner" Label="Owner" Required="true" MaxLength="100" Immediate="true" ImmediateDelay="0" Disabled="Saving"
                             @bind-Value="_owner" Message="@Error("ownerName")" MessageCondition="@(_ => Error("ownerName") is not null)" MessageState="MessageState.Error" />
            <LanguageChoice @bind-Value="_language" Disabled="Saving" IdPrefix="md" Error="@Error("language")" />
            <FluentTextInput Id="md-tags" Label="Tags (comma-separated)" Immediate="true" ImmediateDelay="0" Disabled="Saving"
                             @bind-Value="_tags" Message="@Error("tags")" MessageCondition="@(_ => Error("tags") is not null)" MessageState="MessageState.Error" />
            <FluentDatePicker TValue="DateTime?" Id="md-effective" Label="Effective date" Disabled="Saving"
                              Value="@ParseDate(_effectiveDate)" ValueChanged="@(d => _effectiveDate = d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
            <FluentTextInput Id="md-source" Label="Source" MaxLength="500" Immediate="true" ImmediateDelay="0" Disabled="Saving"
                             @bind-Value="_source" Message="@Error("source")" MessageCondition="@(_ => Error("source") is not null)" MessageState="MessageState.Error" />
            @if (Document.IsOwner)
            {
                <VisibilityChoice @bind-Value="_visibility" Disabled="Saving" Name="md-visibility" />
            }
            else
            {
                <FluentText Class="field-hint">Only the person who imported this document can change who can read it.</FluentText>
            }
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                <FluentButton Appearance="ButtonAppearance.Primary" Disabled="Saving" OnClick="SaveAsync">
                    @if (Saving)
                    {
                        <FluentSpinner aria-label="Saving" />
                    }
                    Save
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline" Disabled="Saving" OnClick="CancelEdit">Cancel</FluentButton>
            </FluentStack>
        }

        <MetaRow Label="Created"><time title="@Formatting.UtcTooltip(Document.CreatedAt)">@Formatting.Local(Document.CreatedAt)</time> @(Document.CreatedBy is null ? "" : " by " + Document.CreatedBy)</MetaRow>
        <MetaRow Label="Updated"><time title="@Formatting.UtcTooltip(Document.UpdatedAt)">@Formatting.Local(Document.UpdatedAt)</time> @(Document.UpdatedBy is null ? "" : " by " + Document.UpdatedBy)</MetaRow>

        @if (CanEdit && !IsEditing)
        {
            <div>
                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="BeginEdit">Edit</FluentButton>
            </div>
        }
    </FluentStack>
</FluentCard>

@* Only present while it is asked, so a page with its own confirm dialog still finds that one first. *@
@if (_confirmVisibility)
{
    <ConfirmDialog Open="true" Title="@(_visibility == "private" ? "Make private" : "Share with everyone")"
                   Message="@(_visibility == "private" ? "Other people will no longer find this document or get answers from it. Answers they already received keep their citations." : "Everyone who signs in will be able to search and read it.")"
                   ConfirmLabel="@(_visibility == "private" ? "Make private" : "Share")" OnConfirm="ConfirmVisibilityAsync" OnCancel="CancelVisibility" />
}

@code {
    private enum Mode { View, Editing, Saving, Conflict }

    private Mode _mode = Mode.View;
    private string? _title = "";
    private string? _owner = "";
    private string _language = LanguageChoice.DetectValue;
    private string? _tags = "";
    private string? _effectiveDate;
    private string? _source;
    private string _visibility = "shared";
    private bool _confirmVisibility;
    private string? _formError;
    private bool _saved;
    private Dictionary<string, string[]> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);

    [Parameter, EditorRequired] public DocumentInfo Document { get; set; } = default!;

    /// <summary>Only owners and maintainers see Edit; the API decides.</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>The server accepted the edit; carries the document as it is now (new revision included).</summary>
    [Parameter] public EventCallback<DocumentInfo> OnSaved { get; set; }

    /// <summary>The user chose to discard the edit and load the current values.</summary>
    [Parameter] public EventCallback OnReload { get; set; }

    [Parameter] public EventCallback OnSessionExpired { get; set; }

    private bool IsEditing => _mode != Mode.View;

    private bool Saving => _mode == Mode.Saving;

    /// <summary>A confident detection that differs from the language the owner chose, or null.</summary>
    private string? DetectedOther =>
        Document is { LanguageSource: "owner", LanguageDetection: "confident", DetectedLanguage: { } detected } && detected != Document.Language
            ? detected
            : null;

    private static DateTime? ParseDate(string? text) =>
        DateTime.TryParseExact(text, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date) ? date : null;

    private string? Error(string field) =>
        _fieldErrors.TryGetValue(field, out var messages) && messages.Length > 0 ? string.Join(' ', messages) : null;

    private void BeginEdit()
    {
        _title = Document.Title;
        _owner = Document.OwnerName;
        _language = Document.LanguageSource == "detect" ? LanguageChoice.DetectValue : Document.Language;
        _tags = string.Join(", ", Document.Tags);
        _effectiveDate = Document.EffectiveDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
        _source = Document.Source;
        _visibility = Document.Visibility;
        _formError = null;
        _saved = false;
        _fieldErrors = new(StringComparer.OrdinalIgnoreCase);
        _mode = Mode.Editing;
    }

    private void CancelEdit()
    {
        _mode = Mode.View;
        _formError = null;
        _fieldErrors = new(StringComparer.OrdinalIgnoreCase);
    }

    private void KeepEditing() => _mode = Mode.Editing;

    private async Task ReloadAsync()
    {
        _mode = Mode.View;
        _fieldErrors = new(StringComparer.OrdinalIgnoreCase);
        await OnReload.InvokeAsync();
    }

    private string[] ParseTags() =>
        [.. (_tags ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct()];

    private bool Validate()
    {
        _fieldErrors = new(StringComparer.OrdinalIgnoreCase);

        void Require(string field, string value, string label, int max)
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                _fieldErrors[field] = [$"{label} is required."];
            }
            else if (value.Trim().Length > max)
            {
                _fieldErrors[field] = [$"{label} must be at most {max} characters."];
            }
        }

        Require("title", _title ?? "", "Title", 200);
        Require("ownerName", _owner ?? "", "Owner", 100);
        if (!LanguageChoice.IsValid(_language))
        {
            _fieldErrors["language"] = ["Language code must be two letters, for example de."];
        }

        var tags = ParseTags();
        if (tags.Length > 20 || tags.Any(t => t.Length > 50))
        {
            _fieldErrors["tags"] = ["Use at most 20 tags of up to 50 characters."];
        }

        if (_source?.Length > 500)
        {
            _fieldErrors["source"] = ["Source must be at most 500 characters."];
        }

        return _fieldErrors.Count == 0;
    }

    private async Task SaveAsync()
    {
        if (Saving || !Validate())
        {
            return;
        }

        // Changing who can read a document is announced before it happens (spec 016).
        if (Document.IsOwner && _visibility != Document.Visibility)
        {
            _confirmVisibility = true;
            return;
        }

        await SaveConfirmedAsync();
    }

    private void CancelVisibility() => _confirmVisibility = false;

    private async Task ConfirmVisibilityAsync()
    {
        _confirmVisibility = false;
        await SaveConfirmedAsync();
    }

    private async Task SaveConfirmedAsync()
    {
        var update = new MetadataUpdate(
            (_title ?? "").Trim(), (_owner ?? "").Trim(), _language, ParseTags(),
            string.IsNullOrWhiteSpace(_effectiveDate) ? null : _effectiveDate, string.IsNullOrWhiteSpace(_source) ? null : _source.Trim(),
            Document.IsOwner ? _visibility : null);
        await SendAsync(update);
    }

    /// <summary>Adopts the detected language and keeps every other field as it is (spec 018).</summary>
    private async Task UseDetectedAsync()
    {
        if (Saving || DetectedOther is not { } detected)
        {
            return;
        }

        BeginEdit();
        _language = detected;
        await SaveConfirmedAsync();
    }

    private async Task SendAsync(MetadataUpdate update)
    {
        _formError = null;
        _mode = Mode.Saving;
        var result = await Api.UpdateAsync(Document.Id, Document.Revision, update, CancellationToken.None);
        if (result.IsSuccess)
        {
            _mode = Mode.View;
            _saved = true;
            await OnSaved.InvokeAsync(result.Value);
            return;
        }

        _mode = Mode.Editing;
        ShowError(result.Error!);
    }

    private void ShowError(ApiError error)
    {
        switch (error)
        {
            case { Status: 401 }:
                _ = OnSessionExpired.InvokeAsync();
                break;
            case { Status: 403, Code: "documents.visibility_owner_only" }:
                _formError = "Only the person who imported this document can change who can read it.";
                break;
            case { Status: 403 }:
                _formError = "You are not allowed to edit documents.";
                break;
            case { Status: 404 }:
                _formError = "This document no longer exists.";
                break;
            case { Status: 412 }:
                _mode = Mode.Conflict;
                break;
            case { Status: 400 }:
                foreach (var (field, messages) in error.Fields)
                {
                    _fieldErrors[field] = messages;
                }

                _formError = _fieldErrors.Count == 0 ? error.Message : null;
                break;
            default:
                _formError = "The changes could not be saved. Check your connection and try again.";
                break;
        }
    }
}
