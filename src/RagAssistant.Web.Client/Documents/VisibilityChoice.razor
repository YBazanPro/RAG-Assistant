@* Who can read a document (ADR 0009). Used by the import dialog and the metadata panel. *@
<FluentRadioGroup TValue="string" Label="Visibility" Name="@Name" Value="@Value" ValueChanged="OnValueChanged" Disabled="Disabled" Orientation="Orientation.Vertical">
    <FluentRadio TValue="string" Value="@("shared")" Label="Shared: everyone who signs in can search and read it" />
    <FluentRadio TValue="string" Value="@("private")" Label="Private: only you; it is never used to answer anyone else's questions" />
</FluentRadioGroup>

@code {
    [Parameter] public string Value { get; set; } = "shared";

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string Name { get; set; } = "visibility";

    private Task OnValueChanged(string? value) => ValueChanged.InvokeAsync(value ?? "shared");
}
