<FluentDataGrid TGridItem="VersionItem" Items="@Versions.AsQueryable()" ItemKey="@(v => v.Id)" MultiLine="true" aria-label="Versions of this document"
                GridTemplateColumns="1.2fr 0.8fr 0.8fr 1.2fr 0.7fr 0.7fr 1.4fr 2.4fr 1fr" Class="version-table">
    <TemplateColumn Title="Version">
        Version @context.Number
        @if (context.IsActive)
        {
            <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success" Class="active-chip">Active</FluentBadge>
        }
    </TemplateColumn>
    <TemplateColumn Title="Status">@context.Status</TemplateColumn>
    <TemplateColumn Title="Format">@context.SourceFormat</TemplateColumn>
    <TemplateColumn Title="File"><span title="@context.OriginalFileName">@context.OriginalFileName</span></TemplateColumn>
    <TemplateColumn Title="Size" Align="DataGridCellAlignment.End">@Formatting.Size(context.SizeBytes)</TemplateColumn>
    <TemplateColumn Title="Passages" Align="DataGridCellAlignment.End">@(context.PassageCount?.ToString() ?? "—")</TemplateColumn>
    <TemplateColumn Title="Created">
        <time title="@Formatting.UtcTooltip(context.CreatedAt)">@Formatting.Local(context.CreatedAt)</time> by @context.CreatedBy
    </TemplateColumn>
    <TemplateColumn Title="Runs">
        <ul class="run-list">
            @foreach (var run in context.Runs)
            {
                <li>
                    Attempt @run.Attempt: @run.Status
                    @if (run.Status == "failed")
                    {
                        <span> at @run.Stage — @(run.ErrorMessage ?? run.ErrorCode)</span>
                    }
                    <span class="run-times">
                        queued @Formatting.Local(run.QueuedAt)@(run.StartedAt is { } s ? $", started {Formatting.Local(s)}" : "")@(run.FinishedAt is { } f ? $", finished {Formatting.Local(f)}" : "")
                    </span>
                </li>
            }
        </ul>
    </TemplateColumn>
    <TemplateColumn Title="Actions">
        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => OnViewPassages.InvokeAsync(context.Number))">View passages</FluentButton>
    </TemplateColumn>
</FluentDataGrid>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<VersionItem> Versions { get; set; } = [];

    [Parameter] public EventCallback<int> OnViewPassages { get; set; }
}
