@page "/documents/{DocumentId:guid}"
@attribute [Authorize(Policy = PolicyNames.KnowledgeSeeker)]
@implements IDisposable
@inject IDocumentsApi Api
@inject NavigationManager Navigation
@inject IAuthorizationService Authorization
@inject AuthenticationStateProvider AuthenticationState
@inject TimeProvider Clock

<PageTitle>@(_document?.Title ?? "Document") · RagAssistant</PageTitle>

@* Prerendering stops at the shell: the data is fetched once, after the first interactive render. *@
@if (_state == LoadState.Loading)
{
    <PageHeader Title="Document" />
    <LoadingState Label="Loading document" />
}
else if (_state == LoadState.SessionExpired)
{
    <SignInRequired />
}
else if (_state == LoadState.NotFound)
{
    <ErrorState Title="Document not found" Message="This document does not exist or was removed.">
        <Action>
            <FluentAnchorButton Href="documents" Appearance="ButtonAppearance.Primary">Back to documents</FluentAnchorButton>
        </Action>
    </ErrorState>
}
else if (_state == LoadState.Failed || _document is null)
{
    <ErrorState Title="Document could not be loaded" Message="@_errorMessage" Retry="ReloadAsync" />
}
else
{
    <PageHeader Title="@_document.Title">
        <Actions>
            <VisibilityBadge Visibility="@_document.Visibility" />
            <DocumentStatusBadge Status="@_document.Status" />
        </Actions>
    </PageHeader>

    @if (_isOwner)
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true" role="group" aria-label="Document actions" Class="document-actions">
            <span title="@NewVersionBlockedReason">
                <FluentButton Appearance="ButtonAppearance.Outline" Disabled="@(NewVersionBlockedReason is not null)" OnClick="@(() => _uploadOpen = true)">Upload new version</FluentButton>
            </span>
            <span title="@ReprocessBlockedReason">
                <FluentButton Appearance="ButtonAppearance.Outline" Disabled="@(ReprocessBlockedReason is not null)" OnClick="@(() => _confirm = Confirm.Reprocess)">Reprocess</FluentButton>
            </span>
            @if (_document.Status == "archived")
            {
                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => _confirm = Confirm.Restore)">Restore</FluentButton>
            }
            else
            {
                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => _confirm = Confirm.Archive)">Archive</FluentButton>
            }
        </FluentStack>
    }

    <p class="detail-summary">
        @_document.Language
        · Version @(DisplayVersionNumber?.ToString() ?? "—")
        · Last activity <time title="@Formatting.UtcTooltip(_document.UpdatedAt)">@Formatting.Local(_document.UpdatedAt)</time>
    </p>

    @if (_retryError is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false" role="alert">@_retryError</FluentMessageBar>
    }
    @if (_actionError is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false" role="alert" Class="action-error">
            @_actionError
            @if (_actionDuplicateId is { } existing)
            {
                <FluentLink Href="@($"documents/{existing}")">Open it</FluentLink>
            }
        </FluentMessageBar>
    }

    <IngestionStatus Run="_document.LatestRun"
                     DocumentId="DocumentId"
                     Live="_isOwner"
                     CanRetry="@(_isOwner && _document.Status != "archived")"
                     OnRefresh="ReloadAsync"
                     OnRetry="RetryAsync"
                     OnFinished="ReloadAsync"
                     OnSessionExpired="@(() => { _state = LoadState.SessionExpired; StateHasChanged(); })" />

    <FluentTabs ActiveTabId="@ActiveTab" ActiveTabIdChanged="OnTabChanged" aria-label="Document sections">
        <FluentTab Id="metadata" Header="Metadata">
            <DocumentMetadataPanel Document="_document"
                                   CanEdit="_isOwner"
                                   OnSaved="OnMetadataSaved"
                                   OnReload="ReloadAsync"
                                   OnSessionExpired="@(() => { _state = LoadState.SessionExpired; StateHasChanged(); })" />
        </FluentTab>
        <FluentTab Id="passages" Header="Passages">
            @if (ActiveTab == "passages")
            {
                @if (_versions.Count == 0 || PassageVersion is null)
                {
                    <EmptyState Title="No passages" Description="Ingestion has not finished or failed." />
                }
                else
                {
                    <PassageList DocumentId="DocumentId"
                                 Versions="_versions"
                                 VersionNumber="PassageVersion.Value"
                                 Focus="PassageId"
                                 ReloadToken="_reloadToken"
                                 OnVersionChanged="SelectVersion"
                                 OnSessionExpired="@(() => { _state = LoadState.SessionExpired; StateHasChanged(); })" />
                }
            }
        </FluentTab>
        <FluentTab Id="questions" Header="Suggested questions">
            @if (ActiveTab == "questions")
            {
                <SuggestedQuestionsPanel Document="_document" CanEdit="_isOwner" OnSaved="OnMetadataSaved"
                                         OnSessionExpired="@(() => { _state = LoadState.SessionExpired; StateHasChanged(); })" />
            }
        </FluentTab>
        <FluentTab Id="history" Header="History">
            @if (ActiveTab == "history")
            {
                <VersionHistory DocumentId="DocumentId" Versions="_versions" OnViewPassages="ViewPassages" />
            }
        </FluentTab>
    </FluentTabs>

    @if (_isOwner)
    {
        <DocumentUpload Open="_uploadOpen"
                        DocumentId="DocumentId"
                        DocumentTitle="@_document.Title"
                        OnClose="@(() => _uploadOpen = false)"
                        OnVersionUploaded="OnVersionUploadedAsync"
                        OnStale="ReloadAsync" />
        <ConfirmDialog Open="@(_confirm != Confirm.None)"
                       Title="@ConfirmTitle"
                       Message="@ConfirmMessage"
                       ConfirmLabel="@ConfirmTitle"
                       Destructive="@(_confirm == Confirm.Archive)"
                       OnConfirm="ConfirmActionAsync"
                       OnCancel="@(() => _confirm = Confirm.None)" />
    }
}

@code {
    private enum LoadState { Loading, Loaded, NotFound, Failed, SessionExpired }

    private enum Confirm { None, Reprocess, Archive, Restore }

    private readonly CancellationTokenSource _lifetime = new();

    private LoadState _state = LoadState.Loading;
    private DocumentInfo? _document;
    private IReadOnlyList<VersionItem> _versions = [];
    private string _errorMessage = "";
    private string? _retryError;
    private bool _isOwner;
    private bool _uploadOpen;
    private Confirm _confirm;
    private string? _actionError;
    private Guid? _actionDuplicateId;
    private bool _started;
    private int _reloadToken;

    [Parameter] public Guid DocumentId { get; set; }

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    [SupplyParameterFromQuery(Name = "version")] public string? Version { get; set; }

    [SupplyParameterFromQuery(Name = "passage")] public string? Passage { get; set; }

    private string? LatestStatus => _document?.LatestVersion?.Status;

    private string? NewVersionBlockedReason =>
        _document?.Status == "archived" ? "Restore the document before uploading a new version."
        : LatestStatus is "queued" or "processing" ? "Wait until the current version has been indexed."
        : null;

    private string? ReprocessBlockedReason =>
        NewVersionBlockedReason ?? (LatestStatus == "indexed" ? null : "Only an indexed version can be reprocessed.");

    private string ConfirmTitle => _confirm switch
    {
        Confirm.Reprocess => "Reprocess",
        Confirm.Archive => "Archive",
        Confirm.Restore => "Restore",
        _ => "Confirm",
    };

    private string ConfirmMessage => _confirm switch
    {
        Confirm.Reprocess => "Reprocess builds a new version from the stored content. The current version stays available until the new one is indexed.",
        Confirm.Archive => "Archived documents are no longer used to answer questions. You can restore it later.",
        Confirm.Restore => "The document will be used to answer questions again.",
        _ => "",
    };

    private string ActiveTab => Tab is "passages" or "history" or "questions" ? Tab : "metadata";

    private Guid? PassageId => Guid.TryParse(Passage, out var id) ? id : null;

    /// <summary>The active version, else the latest (spec 008); the active number comes from the versions list.</summary>
    private int? DisplayVersionNumber =>
        _versions.FirstOrDefault(v => v.IsActive)?.Number ?? _document?.LatestVersion?.Number;

    private int? PassageVersion =>
        int.TryParse(Version, out var requested) && _versions.Any(v => v.Number == requested) ? requested : DisplayVersionNumber;

    protected override async Task OnParametersSetAsync()
    {
        if (_started && _document is not null && _document.Id != DocumentId)
        {
            await LoadAsync(showLoading: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _started = true;
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        _isOwner = (await Authorization.AuthorizeAsync(user, PolicyNames.ContentOwner)).Succeeded;
        await LoadAsync(showLoading: false);
        StateHasChanged();
    }

    private Task ReloadAsync() => LoadAndRefreshAsync();

    private async Task LoadAndRefreshAsync()
    {
        await LoadAsync(showLoading: false);
        _reloadToken++;
        StateHasChanged();
    }

    private async Task LoadAsync(bool showLoading)
    {
        if (showLoading)
        {
            _state = LoadState.Loading;
        }

        var documentTask = Api.GetAsync(DocumentId, _lifetime.Token);
        var versionsTask = Api.GetVersionsAsync(DocumentId, _lifetime.Token);
        var document = await documentTask;
        var versions = await versionsTask;
        if (_lifetime.IsCancellationRequested)
        {
            return;
        }

        var error = document.Error ?? versions.Error;
        if (error is not null)
        {
            _state = error.IsUnauthenticated ? LoadState.SessionExpired
                : error.IsNotFound ? LoadState.NotFound
                : LoadState.Failed;
            _errorMessage = error.Status == 0 || error.Status >= 500 ? "The server could not be reached. Try again in a moment." : error.Message;
            return;
        }

        _document = document.Value;
        _versions = versions.Value.Items;
        WatchSuggestions();
        _state = LoadState.Loaded;
    }

    private async Task RetryAsync()
    {
        _retryError = null;
        var result = await Api.RetryAsync(DocumentId, _lifetime.Token);
        if (!result.IsSuccess)
        {
            _retryError = result.Error!.Status == 403 ? "You are not allowed to retry ingestion."
                : result.Error.Status == 409 ? "This document cannot be retried right now."
                : "The retry could not be started. Try again.";
            return;
        }

        // The new run is the document's latest: reload so the status switches to it and a new stream opens.
        await LoadAndRefreshAsync();
    }

    private Task OnMetadataSaved(DocumentInfo saved)
    {
        _document = saved;
        _actionError = null;
        return Task.CompletedTask;
    }

    private async Task OnVersionUploadedAsync(VersionAccepted accepted)
    {
        _uploadOpen = false;
        _actionError = null;
        _actionDuplicateId = null;
        // The new run is the document's latest: reload so the status switches to it and a new stream opens.
        await LoadAndRefreshAsync();
    }

    private async Task ConfirmActionAsync()
    {
        var action = _confirm;
        _confirm = Confirm.None;
        _actionError = null;
        _actionDuplicateId = null;

        ApiError? error = action switch
        {
            Confirm.Reprocess => (await Api.ReprocessAsync(DocumentId, _lifetime.Token)).Error,
            Confirm.Archive => (await Api.ArchiveAsync(DocumentId, _lifetime.Token)).Error,
            Confirm.Restore => (await Api.RestoreAsync(DocumentId, _lifetime.Token)).Error,
            _ => null,
        };

        if (error is not null)
        {
            _actionError = error switch
            {
                { Status: 401 } => "Your session has expired. Sign in again, then retry.",
                { Status: 403 } => "You are not allowed to do that.",
                { Status: 409, Code: "documents.duplicate_content" } => "Another active document already has this content.",
                { Status: 409 } => error.Message,
                _ => "The action could not be completed. Try again.",
            };
            _actionDuplicateId = error.Code == "documents.duplicate_content" ? error.ExistingDocumentId : null;
        }

        // Success or a 409 both mean the copy on this page may be stale.
        await LoadAndRefreshAsync();
    }

    private void OnTabChanged(string? tab)
    {
        // The tabs raise a change event while the page is torn down; once the user has followed another link, it must not navigate back.
        if (!new Uri(Navigation.Uri).AbsolutePath.Equals($"/documents/{DocumentId}", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (tab is not null && tab != ActiveTab)
        {
            Navigate(tab, tab == "passages" ? Version : null, null);
        }
    }

    private void SelectVersion(int number) => Navigate("passages", number.ToString(), null);

    private void ViewPassages(int number) => Navigate("passages", number.ToString(), null);

    private void Navigate(string tab, string? version, string? passage)
    {
        var parts = new List<string>();
        if (tab != "metadata")
        {
            parts.Add($"tab={tab}");
        }

        if (version is not null)
        {
            parts.Add($"version={Uri.EscapeDataString(version)}");
        }

        if (passage is not null)
        {
            parts.Add($"passage={Uri.EscapeDataString(passage)}");
        }

        var url = $"documents/{DocumentId}" + (parts.Count == 0 ? "" : "?" + string.Join('&', parts));
        Navigation.NavigateTo(url, new NavigationOptions { ReplaceHistoryEntry = true });
    }

    // Spec 020: suggested questions are written after the run has completed, when the ingestion stream is already done with the page.
    // While they are pending the page looks again now and then, and takes only those fields, so an edit in progress is not reset.
    private bool _pollingSuggestions;

    private void WatchSuggestions()
    {
        if (_document?.SuggestionsStatus == "pending" && !_pollingSuggestions)
        {
            _pollingSuggestions = true;
            _ = PollSuggestionsAsync(_lifetime.Token);
        }
    }

    private async Task PollSuggestionsAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(SuggestionsPollInterval, Clock, cancellationToken);
                var result = await Api.GetAsync(DocumentId, cancellationToken);
                if (!result.IsSuccess)
                {
                    return;
                }

                if (result.Value.SuggestionsStatus != "pending")
                {
                    await InvokeAsync(() =>
                    {
                        _document = _document is null ? null : _document with
                        {
                            SuggestedQuestions = result.Value.SuggestedQuestions,
                            SuggestionsStatus = result.Value.SuggestionsStatus,
                            SuggestionsError = result.Value.SuggestionsError,
                        };
                        StateHasChanged();
                    });
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // The page is gone.
        }
        finally
        {
            _pollingSuggestions = false;
        }
    }

    private static readonly TimeSpan SuggestionsPollInterval = TimeSpan.FromSeconds(3);

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
