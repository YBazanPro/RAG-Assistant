@* The report form (spec 014): a required category and an optional comment, inside the shared confirm dialog. *@
<ConfirmDialog Open="Open" Title="Report an issue" ConfirmLabel="Submit" ConfirmDisabled="Busy" OnConfirm="SubmitAsync" OnCancel="OnCancel">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
        @if (Error is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false" role="alert">@Error</FluentMessageBar>
        }
        <FluentSelect Id="@($"report-category-{IdSuffix}")" Label="What is wrong?" Required="true" TOption="CategoryChoice" TValue="string" Items="Categories"
                      OptionValue="@(c => c.Value)" OptionText="@(c => c.Text)" Value="@_category" ValueChanged="OnCategoryChanged"
                      Message="@_categoryError" MessageCondition="@(_ => _categoryError is not null)" MessageState="MessageState.Error" />
        <FluentTextArea Id="@($"report-comment-{IdSuffix}")" Label="Comment (optional)" MaxLength="1000" Immediate="true" ImmediateDelay="0"
                        @bind-Value="_comment" />
        <FluentText Block="true" Class="field-hint">@(_comment?.Length ?? 0) / 1000</FluentText>
    </FluentStack>
</ConfirmDialog>

@code {
    private static readonly CategoryChoice[] Categories =
    [
        new("", "Choose a category"),
        new("incorrect", "The answer is incorrect"),
        new("unsupported_by_sources", "The answer is not supported by the sources"),
        new("wrong_source", "A cited source is wrong"),
        new("outdated", "The information is outdated"),
        new("other", "Something else"),
    ];

    private bool _wasOpen;
    private string _category = "";
    private string? _comment;
    private string? _categoryError;

    [Parameter] public bool Open { get; set; }

    [Parameter] public bool Busy { get; set; }

    /// <summary>Makes the field ids unique when several answers have a dialog.</summary>
    [Parameter, EditorRequired] public string IdSuffix { get; set; } = "";

    /// <summary>A failure of the last submit, shown inside the dialog.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public EventCallback<ReportRequest> OnSubmit { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    protected override void OnParametersSet()
    {
        // Each opening starts from an empty form.
        if (Open && !_wasOpen)
        {
            _category = "";
            _comment = null;
            _categoryError = null;
        }

        _wasOpen = Open;
    }

    private void OnCategoryChanged(string value)
    {
        _category = value;
        _categoryError = null;
    }

    private Task SubmitAsync()
    {
        if (string.IsNullOrEmpty(_category))
        {
            _categoryError = "Choose a category.";
            return Task.CompletedTask;
        }

        return OnSubmit.InvokeAsync(new ReportRequest(_category, string.IsNullOrWhiteSpace(_comment) ? null : _comment.Trim()));
    }
}
