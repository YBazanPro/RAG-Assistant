@inject IThemeService Themes
@inject IJSRuntime JS

<div class="theme-toggle" role="group" aria-label="Theme">
    @foreach (var option in Options)
    {
        <FluentButton Appearance="@(_mode == option.Mode ? ButtonAppearance.Primary : ButtonAppearance.Subtle)"
                      aria-pressed="@(_mode == option.Mode ? "true" : "false")"
                      OnClick="() => SelectAsync(option.Mode)">@option.Label</FluentButton>
    }
</div>

@code {
    private const string StorageKey = "ragassistant.theme";

    private static readonly (ThemeMode Mode, string Label)[] Options =
    [
        (ThemeMode.System, "System"),
        (ThemeMode.Light, "Light"),
        (ThemeMode.Dark, "Dark"),
    ];

    private ThemeMode _mode = ThemeMode.System;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The toggle owns the choice (Fluent only knows the effective light/dark result, which cannot tell "System" from a pick).
        var saved = await ReadSavedAsync();
        if (Enum.TryParse<ThemeMode>(saved, out var mode) && mode != _mode)
        {
            _mode = mode;
            await Themes.SetThemeAsync(mode);
            StateHasChanged();
        }
    }

    private async Task SelectAsync(ThemeMode mode)
    {
        _mode = mode;
        await Themes.SetThemeAsync(mode);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, mode.ToString());
        }
        catch (JSException)
        {
            // Storage can be blocked (private window, site data disabled): the theme still applies for this visit.
        }
    }

    private async Task<string?> ReadSavedAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        }
        catch (JSException)
        {
            return null;
        }
    }
}
