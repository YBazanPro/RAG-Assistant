@inject IThemeService Themes
@inject IJSRuntime JS

<FluentButton Id="user-menu-button" Class="user-menu-button" Appearance="ButtonAppearance.Subtle"
              aria-haspopup="menu">
    <span class="user-name">@UserName</span> <span aria-hidden="true">▾</span>
</FluentButton>

<FluentMenu @ref="_menu" Trigger="user-menu-button" aria-label="User menu">
    <FluentMenuList>
        @foreach (var option in Options)
        {
            var mode = option.Mode;
            <FluentMenuItem Role="MenuItemRole.Radio" Checked="@(_mode == mode)"
                            CheckedChanged="@(isChecked => isChecked == true ? SelectAsync(mode) : Task.CompletedTask)">@option.Label</FluentMenuItem>
        }
    </FluentMenuList>
</FluentMenu>

@code {
    private const string StorageKey = "ragassistant.theme";

    private static readonly (ThemeMode Mode, string Label)[] Options =
    [
        (ThemeMode.System, "System theme"),
        (ThemeMode.Light, "Light theme"),
        (ThemeMode.Dark, "Dark theme"),
    ];

    [Parameter, EditorRequired] public string UserName { get; set; } = "";

    private ThemeMode _mode = ThemeMode.System;
    private FluentMenu? _menu;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The toggle owns the choice (Fluent only knows the effective light/dark result, which cannot tell "System" from a pick).
        var saved = await ReadSavedAsync();
        if (Enum.TryParse<ThemeMode>(saved, out var mode) && mode != _mode)
        {
            _mode = mode;
            await Themes.SetThemeAsync(mode);
            StateHasChanged();
        }
    }

    private async Task SelectAsync(ThemeMode mode)
    {
        _mode = mode;
        await Themes.SetThemeAsync(mode);
        if (_menu is not null)
        {
            // Radio items keep the popup open; a choice made should dismiss it.
            await _menu.CloseMenuAsync();
        }

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, mode.ToString());
        }
        catch (JSException)
        {
            // Storage can be blocked (private window, site data disabled): the theme still applies for this visit.
        }
    }

    private async Task<string?> ReadSavedAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        }
        catch (JSException)
        {
            return null;
        }
    }
}
