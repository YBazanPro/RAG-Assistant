<div class="nav-container">
    <FluentButton Class="nav-toggle" Appearance="ButtonAppearance.Subtle"
                  aria-expanded="@(_open ? "true" : "false")" aria-controls="main-nav"
                  OnClick="Toggle">Menu</FluentButton>

    <nav id="main-nav" aria-label="Main" class="@(_open ? "nav-links open" : "nav-links")">
        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="Close">Home</NavLink>
                <AuthorizeView Policy="@PolicyNames.KnowledgeSeeker" Context="seeker">
                    <NavLink class="nav-link" href="chat" @onclick="Close">Chat</NavLink>
                    <NavLink class="nav-link" href="documents" @onclick="Close">Documents</NavLink>
                </AuthorizeView>
                <AuthorizeView Policy="@PolicyNames.Maintainer" Context="maintainer">
                    <NavLink class="nav-link" href="admin" @onclick="Close">Admin</NavLink>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool _open;

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;
}
