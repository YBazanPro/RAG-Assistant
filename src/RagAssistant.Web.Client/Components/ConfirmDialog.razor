<div @onkeydown="OnKeyDownAsync">
    <FluentDialog @ref="_dialog" Modal="true" OnStateChange="OnStateChangeAsync" aria-label="@Title">
        <FluentDialogBody>
            <TitleTemplate>@Title</TitleTemplate>
            <ChildContent>
                @if (!string.IsNullOrEmpty(Message))
                {
                    <FluentText Block="true">@Message</FluentText>
                }
                @ChildContent
            </ChildContent>
            <ActionTemplate>
                <FluentButton Appearance="ButtonAppearance.Primary" Disabled="ConfirmDisabled"
                              Class="@(Destructive ? "confirm-destructive" : null)"
                              OnClick="ConfirmAsync">@if (ConfirmContent is not null) { @ConfirmContent } else { @ConfirmLabel }</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="CancelAsync">@CancelLabel</FluentButton>
            </ActionTemplate>
        </FluentDialogBody>
    </FluentDialog>
</div>

@code {
    private FluentDialog? _dialog;
    private bool _shown;

    [Parameter] public bool Open { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string Message { get; set; } = "";

    /// <summary>Extra content under the message, for dialogs that ask for input.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool ConfirmDisabled { get; set; }

    /// <summary>Replaces the confirm label, for example with a spinner while the action runs.</summary>
    [Parameter] public RenderFragment? ConfirmContent { get; set; }

    /// <summary>Escape or a dismissal by the dialog itself. Defaults to <see cref="OnCancel"/>; a dialog whose Cancel button does more than close can differ.</summary>
    [Parameter] public EventCallback OnDismiss { get; set; }

    [Parameter] public string ConfirmLabel { get; set; } = "Confirm";

    [Parameter] public string CancelLabel { get; set; } = "Cancel";

    [Parameter] public bool Destructive { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dialog is null || Open == _shown)
        {
            return;
        }

        _shown = Open;
        if (Open)
        {
            await _dialog.ShowAsync();
        }
        else
        {
            await _dialog.HideAsync();
        }
    }

    private Task ConfirmAsync() => OnConfirm.InvokeAsync();

    private Task CancelAsync() => OnCancel.InvokeAsync();

    private Task DismissAsync() => OnDismiss.HasDelegate ? OnDismiss.InvokeAsync() : CancelAsync();

    private Task OnKeyDownAsync(KeyboardEventArgs args) => args.Key == "Escape" ? DismissAsync() : Task.CompletedTask;

    // The web component swallows Escape before Blazor sees a keydown, so a dismissal by the component is reported here.
    // The parent stays the source of truth: if it keeps Open true, the next render shows the dialog again.
    private async Task OnStateChangeAsync(DialogEventArgs args)
    {
        if (args.State == DialogState.Closed && _shown)
        {
            _shown = false;
            await DismissAsync();
            StateHasChanged();
        }
    }
}
